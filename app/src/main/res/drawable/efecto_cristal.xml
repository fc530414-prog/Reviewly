<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo de cristal oscuro y translúcido: mezcla un tono negro/morado muy sutil con brillo para dar efecto de profundidad y desenfoque visual -->
    <gradient
        android:angle="135"
        android:startColor="#26FFFFFF"
        android:centerColor="#0DFFFFFF"
        android:endColor="#05FFFFFF" />

    <!-- Esquinas redondeadas -->
    <corners android:radius="24dp" />

    <!-- Borde de cristal brillante muy fino -->
    <stroke
        android:width="1.2dp"
        android:color="#59FFFFFF" />

</shape>